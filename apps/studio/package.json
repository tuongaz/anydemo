{
  "name": "@tuongaz/seeflow",
  "version": "0.1.43",
  "description": "Local studio that hosts file-defined demos as React Flow canvases wired to a running app via REST + SSE + Zod schema.",
  "keywords": [
    "seeflow",
    "react-flow",
    "diagram",
    "architecture",
    "playable",
    "studio",
    "hono",
    "bun"
  ],
  "homepage": "https://github.com/tuongaz/seeflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuongaz/seeflow.git",
    "directory": "apps/studio"
  },
  "bugs": {
    "url": "https://github.com/tuongaz/seeflow/issues"
  },
  "license": "MIT",
  "author": "Tuong Le",
  "type": "module",
  "bin": {
    "seeflow": "bin/seeflow",
    "seeflow-mcp": "bin/seeflow-mcp"
  },
  "files": ["bin", "src", "!src/**/*.test.ts", "dist/web", "public", "examples", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "NODE_ENV=development bun --hot run src/cli.ts start",
    "start": "bun run src/cli.ts start",
    "test": "bun test",
    "build:web": "cd ../web && bun run build",
    "vendor:tailwind-runtime": "cp ./node_modules/@tailwindcss/browser/dist/index.global.js public/runtime/tailwind.js",
    "prepublishOnly": "bun run vendor:tailwind-runtime && bun run build:web && cp ../../README.md ./README.md"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "elkjs": "^0.11.1",
    "hono": "^4.6.14",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/browser": "^4.3.0",
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  }
}

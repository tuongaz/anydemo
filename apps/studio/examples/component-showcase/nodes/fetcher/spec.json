{
  "root": "card",
  "state": {
    "/cpu": 0,
    "/memory": 0,
    "/notes": "_Click **Refresh** to fetch random stats. The script writes a JSON patch and the runtime merges it into state._"
  },
  "elements": {
    "card": {
      "type": "Card",
      "props": { "title": "Random Stats" },
      "children": [
        "heading",
        "cpuLabel",
        "metricCpu",
        "cpuProgress",
        "memLabel",
        "metricMem",
        "memProgress",
        "refresh",
        "notes"
      ]
    },
    "heading": {
      "type": "Heading",
      "props": { "level": 3, "text": "Script-kind action" }
    },
    "cpuLabel": {
      "type": "Label",
      "props": { "text": "CPU" }
    },
    "metricCpu": {
      "type": "Metric",
      "props": { "label": "Load", "value": { "$state": "/cpu" } }
    },
    "cpuProgress": {
      "type": "Progress",
      "props": { "value": { "$state": "/cpu" } }
    },
    "memLabel": {
      "type": "Label",
      "props": { "text": "Memory" }
    },
    "metricMem": {
      "type": "Metric",
      "props": { "label": "Used", "value": { "$state": "/memory" } }
    },
    "memProgress": {
      "type": "Progress",
      "props": { "value": { "$state": "/memory" } }
    },
    "refresh": {
      "type": "Button",
      "props": { "label": "Refresh", "onClick": { "$action": "refresh" } }
    },
    "notes": {
      "type": "Markdown",
      "props": { "content": { "$state": "/notes" } }
    }
  },
  "actions": {
    "refresh": {
      "kind": "script",
      "interpreter": "bun",
      "scriptPath": "actions/refresh.ts"
    }
  }
}

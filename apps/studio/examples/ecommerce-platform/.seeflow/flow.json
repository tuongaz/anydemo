{
  "version": 2,
  "name": "E-Commerce Platform",
  "nodes": [
    {
      "id": "client",
      "type": "shapeNode",
      "data": {
        "shape": "user",
        "name": "Customer",
        "description": "Web / Mobile / Partner"
      }
    },
    {
      "id": "api-gateway",
      "type": "playNode",
      "data": {
        "name": "API Gateway",
        "kind": "gateway",
        "stateSource": {
          "kind": "request"
        },
        "description": "Auth, rate-limiting, routing.",
        "detail": "file://details/api-gateway.md",
        "playAction": {
          "kind": "script",
          "interpreter": "bun",
          "args": [
            "run"
          ],
          "scriptPath": "scripts/play.ts"
        }
      }
    },
    {
      "id": "auth-service",
      "type": "stateNode",
      "data": {
        "name": "Auth Service",
        "kind": "service",
        "stateSource": {
          "kind": "request"
        },
        "description": "JWT issuance + OAuth2 / OIDC.",
        "detail": "file://details/auth-service.md"
      }
    },
    {
      "id": "product-service",
      "type": "stateNode",
      "data": {
        "name": "Product Catalog",
        "kind": "service",
        "stateSource": {
          "kind": "request"
        },
        "description": "SKUs, variants, pricing, full-text search.",
        "detail": "file://details/product-service.md"
      }
    },
    {
      "id": "cart-service",
      "type": "playNode",
      "data": {
        "name": "Cart Service",
        "kind": "service",
        "stateSource": {
          "kind": "request"
        },
        "description": "Add/remove items, apply coupons, checkout.",
        "detail": "file://details/cart-service.md",
        "playAction": {
          "kind": "script",
          "interpreter": "bun",
          "args": [
            "run"
          ],
          "scriptPath": "scripts/play.ts"
        }
      }
    },
    {
      "id": "order-service",
      "type": "playNode",
      "data": {
        "name": "Order Service",
        "kind": "worker",
        "stateSource": {
          "kind": "event"
        },
        "description": "pending \u2192 confirmed \u2192 shipped \u2192 delivered.",
        "detail": "file://details/order-service.md",
        "playAction": {
          "kind": "script",
          "interpreter": "bun",
          "args": [
            "run"
          ],
          "scriptPath": "scripts/play.ts"
        }
      }
    },
    {
      "id": "payment-service",
      "type": "stateNode",
      "data": {
        "name": "Payment Service",
        "kind": "worker",
        "stateSource": {
          "kind": "event"
        },
        "description": "Stripe + PayPal gateway integration.",
        "detail": "file://details/payment-service.md"
      }
    },
    {
      "id": "notification-service",
      "type": "stateNode",
      "data": {
        "name": "Notification Service",
        "kind": "worker",
        "stateSource": {
          "kind": "event"
        },
        "description": "Email + SMS + push via AWS SES / SNS.",
        "detail": "file://details/notification-service.md"
      }
    },
    {
      "id": "postgresql",
      "type": "shapeNode",
      "data": {
        "shape": "database",
        "name": "PostgreSQL",
        "description": "Orders, users, products \u2014 primary OLTP store"
      }
    },
    {
      "id": "platform-health",
      "type": "htmlNode",
      "data": {
        "name": "Platform Health",
        "htmlPath": "scripts/platform-health.html"
      }
    }
  ],
  "connectors": [
    {
      "id": "c-client-api",
      "source": "client",
      "target": "api-gateway",
      "kind": "http",
      "method": "POST",
      "label": "REST API"
    },
    {
      "id": "c-api-auth",
      "source": "api-gateway",
      "target": "auth-service",
      "kind": "http",
      "method": "POST",
      "label": "POST /auth"
    },
    {
      "id": "c-api-product",
      "source": "api-gateway",
      "target": "product-service",
      "kind": "http",
      "method": "GET",
      "label": "GET /products"
    },
    {
      "id": "c-api-cart",
      "source": "api-gateway",
      "target": "cart-service",
      "kind": "http",
      "method": "POST",
      "label": "POST /cart"
    },
    {
      "id": "c-cart-order",
      "source": "cart-service",
      "target": "order-service",
      "kind": "event",
      "eventName": "cart.checkout",
      "label": "cart.checkout"
    },
    {
      "id": "c-order-payment",
      "source": "order-service",
      "target": "payment-service",
      "kind": "event",
      "eventName": "order.created",
      "label": "order.created"
    },
    {
      "id": "c-payment-notify",
      "source": "payment-service",
      "target": "notification-service",
      "kind": "event",
      "eventName": "payment.captured",
      "label": "payment.captured"
    },
    {
      "id": "c-order-pg",
      "source": "order-service",
      "target": "postgresql",
      "kind": "http",
      "method": "POST",
      "label": "read/write"
    },
    {
      "id": "c-payment-pg",
      "source": "payment-service",
      "target": "postgresql",
      "kind": "http",
      "method": "POST",
      "label": "read/write"
    }
  ]
}

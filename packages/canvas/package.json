{
  "name": "@seeflow/canvas",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "rm -rf dist && bun run build:css && bun run build:js",
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles/index.css -o dist/style.css --minify",
    "build:css:watch": "tailwindcss -c tailwind.config.cjs -i src/styles/index.css -o dist/style.css --watch",
    "build:js": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "files": ["dist", "README.md"],
  "peerDependencies": {
    "@xyflow/react": "*",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "react-markdown": "^10",
    "remark-gfm": "^4"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "dagre": "^0.8.5",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/dagre": "^0.7.54",
    "@types/react": "^18.3.12",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}

{
  "name": "@seeflow/canvas",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./catalog": {
      "import": "./dist/catalog.js",
      "types": "./dist/catalog.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "rm -rf dist && bun run build:css && bun run build:js && bun run scripts/sync-bun-cache.mjs",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/style.css --minify",
    "build:css:dev": "tailwindcss -i src/styles/index.css -o dist/style.dev.css",
    "build:css:watch": "bun run build:css:dev && tailwindcss -i src/styles/index.css -o dist/style.dev.css --watch",
    "build:js": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "files": ["dist", "README.md"],
  "peerDependencies": {
    "@iconify/react": "^5",
    "@xyflow/react": "*",
    "lucide-react": "*",
    "mermaid": "^11",
    "react": "*",
    "react-dom": "*",
    "react-markdown": "^10",
    "recharts": "^2.13.0",
    "remark-gfm": "^4",
    "shiki": "^1.24.0"
  },
  "peerDependenciesMeta": {
    "@iconify/react": { "optional": true },
    "mermaid": { "optional": true },
    "recharts": { "optional": true },
    "shiki": { "optional": true }
  },
  "dependencies": {
    "@iconify-json/logos": "^1",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@iconify/react": "^5",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "^1.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.9.0",
    "mermaid": "^11.4.1",
    "postcss": "^8.4.49",
    "recharts": "^2.13.0",
    "shiki": "^1.24.0",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1",
    "typescript": "^5.6.3"
  }
}

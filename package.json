{
  "name": "seeflow",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "seeflow": "apps/studio/bin/seeflow"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "dev": "concurrently -n canvas-css,workspaces -c blue,green \"cd packages/canvas && bun run build:css:watch\" \"bun run --filter '*' dev\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dagre": "^0.8.5",
    "hono": "^4.6.14",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.6.3"
  }
}

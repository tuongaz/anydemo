{
  "name": "seeflow",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:it": "bun apps/studio/scripts/test-integration.ts",
    "test:it:bun": "bun test ./apps/studio/integration/*.it.ts",
    "test:it:e2e": "bun apps/studio/scripts/run-e2e.ts",
    "test:it:update-snapshots": "bun apps/studio/scripts/run-e2e.ts --update-snapshots",
    "predev": "bun run --filter @seeflow/canvas build:js",
    "dev": "concurrently -n canvas-css,workspaces -c blue,green \"cd packages/canvas && bun run build:css:watch\" \"bun run --filter @tuongaz/seeflow --filter @seeflow/web dev\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "elkjs": "^0.11.1",
    "hono": "^4.6.14",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "concurrently": "^9.2.1",
    "typescript": "^5.6.3"
  }
}
